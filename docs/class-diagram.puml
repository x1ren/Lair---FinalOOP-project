  @startuml
  skinparam classAttributeIconSize 0
  skinparam packageStyle rectangle

  ' Core Application Entry
  class Main {
    +{static} WIDTH: int
    +{static} HEIGHT: int
    +{static} TITLE: String
    +start(stage: Stage): void
    +{static} main(args: String[]): void
  }

  ' Main Game Scene
  class GameScene {
    -player: PlayerActor
    -weapon: Weapon
    -character: CharacterType
    -enemies: EntityManager<EnemyActor>
    -projectiles: EntityManager<Projectile>
    +GameScene(character: CharacterType)
    +getScene(): Scene
    -updateGame(dt: double): void
    -renderGame(): void
    -fireWeapon(): void
    -activateAbility(): void
  }

  ' Abstract Game Loop Engine
  abstract class GameLoop {
    #lastTime: long
    #running: boolean
    +start(): void
    +stop(): void
    #{abstract} update(deltaTime: double): void
    #{abstract} render(): void
    +getCurrentFPS(): int
  }

  ' Abstract Base for Game Objects
  abstract class GameObject {
    #x: double
    #y: double
    #width: double
    #height: double
    +getX(): double
    +getY(): double
    +getWidth(): double
    +getHeight(): double
    +getCenterX(): double
    +getCenterY(): double
    +moveBy(dx: double, dy: double): void
    +{abstract} render(gc: GraphicsContext): void
  }

  ' Player Character
  class PlayerActor {
    -vx: double
    -vy: double
    -facing: int
    -onGround: boolean
    -defeated: boolean
    -spriteSet: SpriteSet
    +step(dt: double): void
    +updateAnimation(dt: double): void
    +triggerHit(): void
    +markDefeated(): void
    +render(gc: GraphicsContext): void
  }

  ' Enemy Character
  class EnemyActor {
    -health: int
    -maxHealth: int
    -damage: int
    -moveSpeed: double
    -target: PlayerActor
    +takeDamage(payload: HitPayload): void
    +applyStatus(status: StatusApplication): void
    +isSlowed(): boolean
    +isBleeding(): boolean
    +render(gc: GraphicsContext): void
  }

  ' Generic Entity Manager (Demonstrates Generics)
  class "EntityManager<T extends GameObject>" as EntityManager {
    -entities: List<T>
    +add(entity: T): void
    +remove(entity: T): void
    +getAll(): List<T>
    +update(dt: double): void
    +render(gc: GraphicsContext): void
  }

  ' Relationships

  ' Main entry point
  Main --> GameScene : creates

  ' GameScene extends GameLoop (Inheritance & Abstraction)
  GameScene --|> GameLoop : extends

  ' GameObject hierarchy (Inheritance & Polymorphism)
  PlayerActor --|> GameObject : extends
  EnemyActor --|> GameObject : extends

  ' GameScene uses entities (Composition)
  GameScene *-- PlayerActor : contains
  GameScene *-- EntityManager : contains

  ' EntityManager manages GameObjects (Generics & Polymorphism)
  EntityManager ..> GameObject : manages <T>

  ' Enemy targets player (Association)
  EnemyActor --> PlayerActor : targets

  note right of Main
    Entry point of the application.
    Demonstrates encapsulation with
    static constants and methods.
  end note

  note right of GameLoop
    Abstract class demonstrating
    abstraction and template method
    pattern. Defines game loop structure.
  end note

  note right of GameObject
    Abstract base class for all game
    entities. Demonstrates abstraction
    and encapsulation of position/size.
  end note

  note bottom of EntityManager
    Generic class demonstrating
    generics and polymorphism.
    Can manage any GameObject type.
  end note

  note left of PlayerActor
    Concrete implementation
    demonstrating inheritance
    and encapsulation.
  end note

  note left of EnemyActor
    Demonstrates inheritance,
    polymorphism, and object
    relationships (targets player).
  end note

  note bottom of GameScene
    Main game controller extending GameLoop.
    Demonstrates inheritance, composition,
    and orchestrates all game entities.
  end note

  @enduml
